{
  "manifest_version": 3,
  "name": "XML Tag Expander",
  "version": "1.1.0",
  "description": "Type :name then Tab to get <name></name> with the cursor inside. Tab again to jump past the closing tag.",
  "permissions": ["storage"],
  "action": {
    "default_title": "XML Tag Expander shortcuts",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
